# Maintainer: Maycon Douglas <hellomaycondouglas@gmail.com>
pkgname=glance-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="A lightweight, high-performance Linux desktop application and process monitor"
arch=('x86_64')
url="https://github.com/maycondouglascc/glance"
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita')
provides=('glance' 'glance-tree')
conflicts=('glance')
source_x86_64=("https://github.com/maycondouglascc/glance/releases/download/v${pkgver}/glance-linux-x86_64.tar.gz")
sha256sums_x86_64=('5283bbdd8cc5d77130797e2f12520264fc43166e0f547adccc734bbe40de719d')

package() {
    cd "$srcdir"
    install -Dm755 glance "$pkgdir/usr/bin/glance"
    install -Dm755 glance-tree "$pkgdir/usr/bin/glance-tree"
    install -Dm644 io.github.maycon.Glance.desktop "$pkgdir/usr/share/applications/io.github.maycon.Glance.desktop"
    install -Dm644 io.github.maycon.Glance.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.maycon.Glance.svg"
    install -Dm644 io.github.maycon.Glance.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.maycon.Glance.metainfo.xml"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
